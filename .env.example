# Copie para .env e ajuste. Em produção, configure no painel do Railway.

# 1 = desenvolvimento (nunca em produção)
DEBUG=1

# Obrigatório em produção: string longa e aleatória
# SECRET_KEY=

# Local: usa postgres://localhost/crm_vo_testa por padrão se não definido
# DATABASE_URL=postgres://usuario:senha@host:5432/banco

# Produção: domínios separados por vírgula
# ALLOWED_HOSTS=crm.pousadavotesta.com.br
# CSRF_TRUSTED_ORIGINS=https://crm.pousadavotesta.com.br

# Logs no stdout (o Railway coleta). DEBUG/INFO/WARNING/ERROR — padrão INFO.
# LOG_LEVEL=INFO
# REDIS_URL=                  # cache compartilhado (add-on Redis); vazio = tabela no Postgres
# SENTRY_DSN=                 # monitoramento de erros (Sentry); vazio = desligado
# SENTRY_ENVIRONMENT=producao
# SENTRY_TRACES_SAMPLE_RATE=0 # fração de requisições com trace de performance (0 a 1)

# Check-out: resíduo de arredondamento até este valor (R$) é quitado sozinho com um
# desconto auditado, em vez de travar a saída. "0" desliga.
# CHECKOUT_TOLERANCIA_ARREDONDAMENTO=0.10

# Pagamentos — gateway: simulado (padrão) | safrapay
# PAGAMENTOS_GATEWAY=simulado

# FNRH Digital — credenciais e CPF do solicitante autorizado; homologar antes de produção.
# FNRH_GATEWAY=simulado
# FNRH_API_URL=https://hom-lowcode.serpro.gov.br/FNRH_API/rest/v2
# FNRH_API_USER=
# FNRH_API_SENHA=
# FNRH_CPF_SOLICITANTE=

# WhatsApp — gateway: simulado (somente testes) | cloud (Meta). Só ligar "cloud"
# com o número verificado na WABA e templates aprovados. Ver docs/Marketing/CRM_WhatsApp.md
# WHATSAPP_GATEWAY=simulado
# WHATSAPP_CLOUD_TOKEN=          # token permanente (System User) da Meta
# WHATSAPP_CLOUD_PHONE_ID=       # Phone Number ID do número na WABA
# WHATSAPP_VERIFY_TOKEN=         # segredo do handshake do webhook (você escolhe)
# WHATSAPP_WABA_ID=              # WhatsApp Business Account ID (gestão de templates)
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_APP_SECRET=          # obrigatório no modo real: valida X-Hub-Signature-256

# Safrapay — chaves de portal-hml.safrapay.com.br (nunca commitar valores reais)
# SAFRAPAY_ENV=hml
# SAFRAPAY_ID=
# SAFRAPAY_CODIGO_ATIVACAO=
# SAFRAPAY_TOKEN=            # Merchant Token (auth: header Authorization = token cru)
# SAFRAPAY_TIMEOUT=10        # segundos de espera pela API (fica abaixo dos 60 s do gunicorn)

# Pix direto (fora do PSP): gera o copia-e-cola localmente pela chave da pousada —
# sem taxa de adquirente. Cartão/boleto seguem pelo PAGAMENTOS_GATEWAY. Confirmação
# do Pix é MANUAL (recepção dá baixa, não há webhook).
# PIX_DIRETO=1
# PIX_CHAVE=                 # CNPJ/e-mail/telefone/chave aleatória da pousada
# PIX_RECEBEDOR_NOME=POUSADA VO TESTA
# PIX_RECEBEDOR_CIDADE=ITA

# E-mail (Zoho) — use senha de app, não a senha de login
# EMAIL_HOST=smtp.zoho.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=1
# EMAIL_HOST_USER=naoresponda@pousadavotesta.com.br
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=Pousada Vô Testa <naoresponda@pousadavotesta.com.br>
# URL pública (links no e-mail de reserva)
# SITE_PUBLIC_URL=https://www.pousadavotesta.com.br

# Kit de contingência (/crm/reservas/kit/) — quem recebe por e-mail, todo dia de
# madrugada, a folha com hospedados, chegadas, saídas e situação dos quartos. É a
# cópia que funciona no celular quando a internet da pousada cai. Vírgula separa;
# vazio (padrão) = não envia nada.
# KIT_CONTINGENCIA_EMAILS=gerencia@pousadavotesta.com.br,recepcao@pousadavotesta.com.br

# Monitor das rotinas ("dead man's switch") — um check do Healthchecks.io por grupo.
# Frequentes: período 10 min, tolerância 10 min. Diárias: cron "15 6 * * *" (UTC),
# tolerância 1 h. Se a rotina não avisar no prazo, ou avisar falha, o monitor alerta.
# Vazio (padrão) = não avisa.
# ROTINAS_MONITOR_FREQUENTES=https://hc-ping.com/<uuid-do-check>
# ROTINAS_MONITOR_DIARIAS=https://hc-ping.com/<uuid-do-check>

# SEO / Analytics do site público (GA4). Vazio = tag não carrega.
# GA_MEASUREMENT_ID=G-XXXXXXXXXX

# --- Mídia em object storage (Cloudflare R2) — opcional ---
# Preencha as 5 para servir/persistir fotos fora do disco efêmero do Railway.
# Sem elas, a mídia usa o filesystem local (dev). Endpoint = API S3; domínio público = leitura.
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=            # https://<accountid>.r2.cloudflarestorage.com
R2_PUBLIC_DOMAIN=          # pub-xxxx.r2.dev  ou  media.pousadavotesta.com.br
# Backup separado da mídia pública. Local e R2 podem funcionar juntos.
# BACKUP_DIR=/app/backups      # exige volume persistente e pg_dump/pg_restore compatíveis
# BACKUP_R2_BUCKET=            # bucket privado, diferente de R2_BUCKET
# BACKUP_R2_ENDPOINT_URL=
# BACKUP_R2_ACCESS_KEY_ID=
# BACKUP_R2_SECRET_ACCESS_KEY=
# BACKUP_R2_PRIVADO=0          # defina 1 após conferir acesso privado e credenciais restritas

# E-mail comercial: simulado (somente testes), smtp ou ses. Site/kit usam SMTP Django.
# EMAIL_GATEWAY=simulado
# EMAIL_COMERCIAL_FROM=
# EMAIL_COMERCIAL_HOST_USER=   # opcional: conta SMTP dedicada ao Comercial
# EMAIL_COMERCIAL_HOST_PASSWORD=
# EMAIL_SES_REGION=
# EMAIL_SES_ACCESS_KEY_ID=
# EMAIL_SES_SECRET_ACCESS_KEY=

# Fiscal Focus NFe v2. Conferir docs/Implementar_fiscal.md antes de habilitar.
# FISCAL_GATEWAY=simulado
# FISCAL_FOCUS_URL=https://homologacao.focusnfe.com.br
# FISCAL_FOCUS_TOKEN=
# FISCAL_EMITENTE_CNPJ=
# FISCAL_MUNICIPIO_IBGE=
# FISCAL_DPS_SERIE=            # série exclusiva deste sistema
# FISCAL_DPS_NUMERO_INICIAL=1  # faixa inicial reservada para evitar colisão com outros emissores
# FISCAL_NFSE_COMPLEMENTOS={}  # JSON revisado pelo responsável fiscal
# FISCAL_NFSE_CODIGO_SERVICO=090101
# FISCAL_NFSE_ISS_ALIQUOTA=4.0 # valor histórico: conferir antes de operar
# FISCAL_NFCE_HABILITADA=0    # só habilitar após IE/CSC/certificado/cadastro no provedor
# FISCAL_WEBHOOK_TOKEN=       # Authorization do callback /crm/fiscal/webhook/
